{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "ignorePatterns": ["dist", "node_modules", "coverage"],
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error"
  }
}

