# Nova Salud Backend - Variables de entorno
# Copie este archivo a .env y ajuste los valores antes de iniciar.

PORT=8081
NODE_ENV=development

# Secreto para firmar JWT. CAMBIAR en producción (mínimo 32 caracteres aleatorios).
JWT_SECRET=cambiar_este_secreto_por_algo_largo_y_aleatorio
JWT_EXPIRES_IN=24h

# SQL Server
DB_USER=novasalud
DB_PASSWORD=cambiar_contraseña_segura
DB_DATABASE=NovaSalud
DB_SERVER=localhost
DB_PORT=1433
DB_ENCRYPT=false

# Origen permitido para CORS. En producción poner el dominio del frontend (ej. https://botica.example.com).
# En desarrollo se acepta cualquier origen (*).
CORS_ORIGIN=*
