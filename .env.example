# ============================================================================
# BOTICA NOVA SALUD - VARIABLES DE ENTORNO (.env.example)
# ============================================================================
# Copie este archivo a `.env` antes de iniciar en desarrollo o producción.
# IMPORTANTE: Nunca exponga secretos del servidor con el prefijo VITE_.

# --- Servidor HTTP y Entorno ---
NODE_ENV=development
PORT=8081
CORS_ORIGIN=http://localhost:3080
DISABLE_HMR=false

# --- Seguridad JWT (Solo Servidor) ---
JWT_SECRET=reemplazar_por_secreto_criptografico_seguro_min_32_bytes
JWT_EXPIRES_IN=24h

# --- Conexión a Microsoft SQL Server (Opcional si se usa el adaptador en memoria) ---
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=reemplazar_password_sql_server
DB_DATABASE=NovaSalud
DB_ENCRYPT=false

# --- Cliente Frontend (Vite) ---
# En Docker con Nginx proxy reverso usar `/api`; en desarrollo independiente `http://localhost:8081/api`
VITE_API_URL=/api
