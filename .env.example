# Nova Salud - Variables de entorno del proyecto
# Copie .env.example a .env en cada servicio (raíz, backend/, frontend/) y ajuste los valores.

# Backend
PORT=8081
NODE_ENV=development
JWT_SECRET=cambiar_este_secreto_por_algo_largo_y_aleatorio_minimo_32_caracteres
JWT_EXPIRES_IN=24h

DB_USER=novasalud
DB_PASSWORD=cambiar_contraseña_segura
DB_DATABASE=NovaSalud
DB_SERVER=localhost
DB_PORT=1433
DB_ENCRYPT=false

# Frontend (Vite)
VITE_API_URL=http://localhost:8081/api

# CORS (producción: dominio del frontend, ej. https://botica.novasalud.example.com)
CORS_ORIGIN=*
